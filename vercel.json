{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 120
    },
    "api/access.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/auth/(setup-status|login|refresh|me|logout)",
      "dest": "/api/access?route=$1"
    },
    {
      "src": "/(api|oauth|o|c|u)/(.*)",
      "dest": "/api/gateway?route=$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
