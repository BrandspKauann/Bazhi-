{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 120
    },
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,docs/**,work/**,outputs/**,frontend/node_modules/**,static/**,.git/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(api|oauth|o|c|u)/(.*)",
      "dest": "/api/index.py?route=$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
